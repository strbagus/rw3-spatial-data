# Server Configuration
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# CCTV NVR / IP Camera Configuration
# IP address of the local NVR / DVR device
CCTV_NVR_HOST=192.168.1.14
# RTSP port (default: 554)
CCTV_NVR_PORT=554
# NVR credentials
CCTV_NVR_USER=admin
CCTV_NVR_PASSWORD=
# RTSP path template ({channel} will be replaced with 1..17, {stream} with 0 for 2K or 1 for 352p)
CCTV_RTSP_PATTERN=/avstream/channel={channel}/stream={stream}.sdp
